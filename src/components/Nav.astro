---
import ThemeToggle from "./ThemeToggle";

const { pathname } = Astro.props;

const links = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/stats", label: "Stats" },
];
---

<header
  class="nav-bg sticky top-0 z-50 backdrop-blur-md border-b"
  style="border-color: var(--border)"
>
  <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a
      href="/"
      class="nav-link font-semibold text-sm tracking-tight"
      style="color: var(--fg)"
    >
      Owen Zheng
    </a>

    <div class="flex items-center gap-2">
      <nav class="flex items-center gap-6 mr-3">
        {links.map((l) => {
          const active = pathname === l.href;
          return (
            <a
              href={l.href}
              class={`nav-link text-sm transition-colors ${active ? "nav-link-active" : ""}`}
              style={`color: ${active ? "var(--accent)" : "var(--muted)"}`}
            >
              {l.label}
            </a>
          );
        })}
      </nav>

      <button
        id="cmd-k-btn"
        class="hidden sm:flex items-center gap-1.5 text-xs px-2.5 py-1.5 rounded-md border transition-colors hover:border-green-300"
        style="border-color: var(--border); color: var(--muted); background: var(--bg-subtle)"
      >
        <span>⌘K</span>
      </button>

      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script>
  document.getElementById("cmd-k-btn")?.addEventListener("click", () => {
    document.dispatchEvent(
      new KeyboardEvent("keydown", { key: "k", metaKey: true, bubbles: true })
    );
  });
</script>
