---
const GITHUB_USER = "whackemowen";

type Stats = {
  repos: number;
  stars: number;
  followers: number;
  topLanguages: string[];
};

async function getStats(): Promise<Stats | null> {
  try {
    const headers: HeadersInit = { Accept: "application/vnd.github.v3+json" };
    if (import.meta.env.GITHUB_TOKEN) {
      headers.Authorization = `Bearer ${import.meta.env.GITHUB_TOKEN}`;
    }

    const [userRes, reposRes] = await Promise.all([
      fetch(`https://api.github.com/users/${GITHUB_USER}`, { headers }),
      fetch(`https://api.github.com/users/${GITHUB_USER}/repos?per_page=100&sort=updated`, { headers }),
    ]);

    if (!userRes.ok) return null;

    const user = await userRes.json();
    const repos = reposRes.ok ? await reposRes.json() : [];

    const stars = Array.isArray(repos)
      ? repos.reduce((acc: number, r: { stargazers_count: number }) => acc + r.stargazers_count, 0)
      : 0;

    const langCounts: Record<string, number> = {};
    if (Array.isArray(repos)) {
      repos.forEach((r: { language?: string }) => {
        if (r.language) langCounts[r.language] = (langCounts[r.language] || 0) + 1;
      });
    }

    const topLanguages = Object.entries(langCounts)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 4)
      .map(([lang]) => lang);

    return { repos: user.public_repos, stars, followers: user.followers, topLanguages };
  } catch {
    return null;
  }
}

const stats = await getStats();
const items = stats
  ? [
      { label: "Public repos", value: stats.repos },
      { label: "Total stars", value: stats.stars },
      { label: "Followers", value: stats.followers },
    ]
  : [];
---

{stats && (
  <section class="py-12 border-t" style="border-color: var(--border)">
    <div class="flex items-center justify-between mb-6">
      <p class="text-[11px] font-semibold uppercase tracking-widest" style="color: var(--accent)">
        GitHub
      </p>
      <a
        href={`https://github.com/${GITHUB_USER}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium hover:underline"
        style="color: var(--muted)"
      >
        @{GITHUB_USER} →
      </a>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-5">
      {items.map((item) => (
        <div
          class="p-4 rounded-xl border text-center"
          style="border-color: var(--border); background: var(--bg-subtle)"
        >
          <div class="text-2xl font-bold" style="color: var(--fg)">{item.value}</div>
          <div class="text-xs mt-0.5" style="color: var(--muted)">{item.label}</div>
        </div>
      ))}
    </div>

    {stats.topLanguages.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {stats.topLanguages.map((lang) => (
          <span
            class="text-xs px-2.5 py-1 rounded-md font-medium"
            style="background: var(--accent-light); color: var(--accent-text); font-family: var(--font-mono)"
          >
            {lang}
          </span>
        ))}
      </div>
    )}
  </section>
)}
