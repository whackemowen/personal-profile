---
import Layout from "../layouts/Layout.astro";
import FadeIn from "../components/FadeIn";

const stats = [
  { label: "Hackathons Attended", value: "1", note: "and counting" },
  { label: "Hackathons Won", value: "0", note: "soon" },
  { label: "All-nighters Pulled", value: "2", note: "for the craft" },
  { label: "Failed Startup Ideas", value: "2", note: "lessons learned" },
  { label: "FTC Seasons", value: "4", note: "years competing" },
  { label: "BC Provincials Won", value: "3", note: "years running" },
];
---

<Layout title="Stats — Owen Zheng">
  <div class="space-y-12">

    <div
      class="border-b"
      style="border-color: var(--border); background: var(--header-gradient)"
    >
      <div class="max-w-5xl mx-auto px-6 py-16">
        <div class="max-w-xl space-y-3">
          <h1 class="fade-up fade-up-1 text-3xl font-bold tracking-tight" style="color: var(--fg)">
            Stats
          </h1>
          <div class="fade-up fade-up-2 w-10 h-1 rounded-full" style="background: var(--accent)" />
          <p class="fade-up fade-up-3 text-lg pt-1" style="color: var(--muted)">
            By the numbers.
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-6 pb-16">
      <FadeIn client:visible>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {stats.map((s) => (
            <div
              class="p-6 rounded-xl border flex flex-col gap-2 transition-all hover:shadow-sm hover:border-green-200"
              style="border-color: var(--border); background: var(--bg)"
            >
              <p class="text-[11px] font-semibold uppercase tracking-widest" style="color: var(--accent)">
                {s.label}
              </p>
              <p class="text-4xl font-bold tracking-tight" style="color: var(--fg)">{s.value}</p>
              <p class="text-xs" style="color: var(--muted)">{s.note}</p>
            </div>
          ))}
        </div>
      </FadeIn>
    </div>

  </div>
</Layout>
