---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import CommandPalette from "../components/CommandPalette";
import "../styles/globals.css";

const { description = "Personal site of Owen Zheng — developer and builder." } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Owen Zheng</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter />
    <script is:inline>
      function applyStoredTheme() {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      }
      applyStoredTheme();
      document.addEventListener("astro:after-swap", applyStoredTheme);
    </script>
  </head>
  <body class="min-h-full flex flex-col">
    <div class="h-[3px] w-full" style="background: linear-gradient(90deg, var(--accent) 0%, #4ade80 100%)" />
    <Nav pathname={pathname} />
    <CommandPalette client:load />
    <main class="flex-1">
      <slot />
    </main>
    <footer
      class="border-t mt-24"
      style="border-color: var(--border-green); background: var(--bg-green)"
    >
      <div
        class="max-w-5xl mx-auto px-6 py-6 flex items-center justify-between text-sm"
        style="color: var(--muted)"
      >
        <span>Owen Zheng</span>
        <span>{new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
